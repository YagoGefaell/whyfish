# Copy to .env and adjust. Never commit .env.
# Every value is optional except STOCKFISH_PATH; defaults live in backend/app/config.py.

# --- Engine ---------------------------------------------------------------
# Absolute path to the Stockfish binary (~ is not expanded).
STOCKFISH_PATH=/home/youruser/.local/bin/stockfish
ENGINE_THREADS=1
ENGINE_HASH_MB=64

# --- Play -----------------------------------------------------------------
# Max thinking time per bot move (seconds), for every level.
# BOT_MOVETIME_S=1.0
# Full-strength search time for a hint / to evaluate a draw offer (seconds).
# HINT_TIME_S=0.3
# DRAW_EVAL_TIME_S=0.3
# The bot accepts a draw if its own evaluation is <= this (centipawns).
# DRAW_ACCEPT_MAX_CP=30
# ...and never before this many full moves have been played in the game.
# DRAW_MIN_MOVES=20
# Your name in exported PGNs.
# PLAYER_NAME=Jugador

# --- Analysis -------------------------------------------------------------
# Engines analysing in parallel (default: CPU count - 1, between 1 and 4).
# ENGINE_POOL_SIZE=3
# Per-position search: seconds and optional max depth; MultiPV lines.
# ANALYSIS_TIME_S=0.5
# ANALYSIS_DEPTH=
# ANALYSIS_MULTIPV=3
# Threads / hash (MB) of each analysis engine.
# ANALYSIS_THREADS=1
# ANALYSIS_HASH_MB=32

# --- Storage --------------------------------------------------------------
# Default: <repo>/data/whyfish.db
# DATABASE_URL=sqlite:////absolute/path/whyfish.db
